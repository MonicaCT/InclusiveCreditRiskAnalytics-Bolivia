{
  "name": "MonicaCT Analytics Theme",
  "dataColors": [
    "#B23A48",
    "#1F7A8C",
    "#E58F2A",
    "#2F5F8F",
    "#5E7D68",
    "#1F2933",
    "#8A4F7D",
    "#6B7280"
  ],
  "background": "#F7F4EF",
