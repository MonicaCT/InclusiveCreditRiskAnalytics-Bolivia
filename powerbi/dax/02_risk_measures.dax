-- Portfolio quality and risk measures

Delinquency Rate :=
DIVIDE (
    CALCULATE (
        SUM ( 'fact_delinquency_monthly'[overdue_kbob] ),
        'fact_delinquency_monthly'[observation_type] = "observed"
    ),
    CALCULATE (
        SUM ( 'fact_portfolio_monthly'[portfolio_kbob] ),
        'fact_portfolio_monthly'[observation_type] = "observed"
    )
)

Risk Penalty :=
AVERAGE ( 'fact_delinquency_monthly'[risk_penalty] )

Portfolio Quality Score :=
100 - ( [Delinquency Rate] * 100 )

Portfolio at Risk Indicator :=`n-- REVIEW_REQUIRED: not available in the public aggregate package. Do not place this measure on dashboard pages until a documented PAR bucket exists.`nBLANK ()

Risk Status Label :=
SWITCH (
    TRUE(),
    [Delinquency Rate] <= 0.01, "Controlled",
    [Delinquency Rate] <= 0.03, "Watch",
    [Delinquency Rate] > 0.03, "Elevated",
    "Not available"
)
